# Uptime Kuma login, used once by setup-kuma.py to create the Hermes push monitors
# (uptime-kuma-api2 over socket.io). The 2FA code is prompted for at run time.
# Copy to .env, fill in, run setup, then delete .env.
KUMA_URL=https://dashboard.domoney.online
KUMA_USERNAME=
KUMA_PASSWORD=
KUMA_GROUP=Hermes

#!/usr/bin/env bash
# minimal SBR for eth0 (public) + wlan0 (wifi)

IFACE="$1"; STATE="$2"

PUB_IF=eth0;   PUB_SRC=203.0.113.3;  PUB_NET=203.0.113.0/28;  PUB_GW=203.0.113.1
WIFI_IF=wlan0; WIFI_SRC=192.168.1.50; WIFI_NET=192.168.1.0/24; WIFI_GW=192.168.1.1

case "$STATE" in
  up)
    sysctl -q -w net.ipv4.conf.all.rp_filter=2 net.ipv4.conf.default.rp_filter=2
    case "$IFACE" in
      "$PUB_IF")
        ip rule del pref 110 2>/dev/null; ip route flush table 201 2>/dev/null
        ip route add "$PUB_NET" dev "$PUB_IF" scope link table 201
        ip route add default via "$PUB_GW" dev "$PUB_IF" table 201
        ip rule  add pref 110 from "$PUB_SRC/32" table 201
        ;;
      "$WIFI_IF")
        ip rule del pref 100 2>/dev/null; ip route flush table 200 2>/dev/null
        ip route add "$WIFI_NET" dev "$WIFI_IF" scope link table 200
        ip route add default via "$WIFI_GW" dev "$WIFI_IF" table 200
        ip rule  add pref 100 from "$WIFI_SRC/32" table 200
        ;;
    esac
    ;;
  down)
    case "$IFACE" in
      "$PUB_IF")  ip rule del pref 110 2>/dev/null; ip route flush table 201 2>/dev/null ;;
      "$WIFI_IF") ip rule del pref 100 2>/dev/null; ip route flush table 200 2>/dev/null ;;
    esac
    ;;
esac
